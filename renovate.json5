{
  extends: [
    'config:recommended',
    'helpers:pinGitHubActionDigests',
  ],

  minimumReleaseAge: '7 days',

  packageRules: [
    {
      matchDatasources: [
        'github-tags',
      ],
      matchPackageNames: [
        'curl/curl',
      ],
      commitMessagePrefix: 'chore(deps):',
    },
  ],

  customManagers: [
    {
      customType: 'regex',

      fileMatch: [
        '^\\.github/workflows/[^/]+\\.ya?ml$',
      ],

      matchStrings: [
        '# renovate: datasource=github-tags depName=curl/curl\\s+CURL_COMMIT:\\s*[\'"](?<currentDigest>[0-9a-f]{40})[\'"]\\s+#\\s+(?<currentValue>curl-[0-9_]+)',
      ],

      datasourceTemplate: 'github-tags',
      depNameTemplate: 'curl/curl',

      versioningTemplate: 'semver',

      currentValueTemplate: '{{{currentValue}}}',

      autoReplaceStringTemplate: '  # renovate: datasource=github-tags depName=curl/curl\n  CURL_COMMIT: \'{{{newDigest}}}\' # {{{newValue}}}',
    },
  ],
}
